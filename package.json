{
  "name": "scan-pointcloud-streamer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Out-of-core scan point cloud viewer with adaptive octree LOD, budgeted streaming, and coverage validation",
  "scripts": {
    "data:prepare": "tsx scripts/prepare-data.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "trajectory": "node scripts/trajectory.mjs",
    "setup": "npm run data:prepare && npm run build"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
